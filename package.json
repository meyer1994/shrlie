{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "clean": "rm -rf .output .wrangler .nuxt node_modules",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply flower",
    "cf:deploy": "wrangler --cwd .output deploy",
    "cf:types": "wrangler types shared/wrangler.d.ts && eslint --fix shared/wrangler.d.ts"
  },
  "dependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/ui": "^4.11.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "uuidv7": "^1.2.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.134",
    "@nuxt/test-utils": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.9.8",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.11.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.135.0"
  }
}